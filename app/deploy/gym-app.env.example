# Copy to /etc/gym-app.env on EACH web server, then: sudo chmod 600 /etc/gym-app.env
# Never commit the real file. SECRET_KEY must be identical on both servers.
DB_HOST=gym-db.xxxxxxxxxxxx.eu-west-2.rds.amazonaws.com
DB_NAME=gym
DB_USER=gym_app
DB_PASSWORD=CHANGE-ME-app-password
SECRET_KEY=paste-output-of: python3 -c "import secrets; print(secrets.token_hex(32))"
AWS_REGION=eu-west-2
# Phase 1: leave empty. Phase 2: set to gym-checkins, then restart gym-app.
CHECKINS_TABLE=
